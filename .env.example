# Пример файла переменных окружения
# Скопируйте этот файл в .env и заполните значения

# Секретный ключ для Flask (сгенерируйте случайную строку)
SECRET_KEY=your-secret-key-here

# URL базы данных (для продакшена будет автоматически установлен Heroku)
DATABASE_URL=postgresql://username:password@localhost:5432/dispatcher_db

# Режим работы (development/production)
FLASK_ENV=development

# Порт (для продакшена будет автоматически установлен Heroku)
PORT=5000

# Учетные данные администратора
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here